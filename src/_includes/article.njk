---
layout: base
---

{% set schemaUrl = site.url + "/news/" + slug + "/" %}

<main style="max-width: 50rem; margin: 0 auto; padding: 4rem 2rem;">
    <article>
        <!-- Article Breadcrumb -->
        <nav aria-label="Breadcrumb" style="margin-bottom: 3rem;">
            <ol style="display: flex; gap: 0.5rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; color: var(--text); list-style: none;">
                <li><a href="/" style="color: var(--cyan); text-decoration: none;">Inicio</a></li>
                <li style="color: var(--text); margin: 0 0.5rem;">/</li>
                <li><a href="/news/" style="color: var(--cyan); text-decoration: none;">Noticias</a></li>
                <li style="color: var(--text); margin: 0 0.5rem;">/</li>
                <li aria-current="page" style="color: var(--text);">{{ title }}</li>
            </ol>
        </nav>

        <!-- Article Date Eyebrow -->
        {% if published %}
        <div class="section-eyebrow" style="margin-bottom: 1.5rem;">{{ published | readableDate('es') }}</div>
        {% endif %}

        <!-- Article Title -->
        <h1 style="font-size: 2.5rem; font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--text-bright); margin-bottom: 2rem; line-height: 1.3;">{{ title }}</h1>

        <!-- Article Metadata -->
        <div style="display: flex; gap: 2rem; padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border); font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; color: var(--text);">
            <div>
                <span style="display: block; color: var(--text); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Autor</span>
                <span style="color: var(--text-bright);">{{ author or site.author.name }}</span>
            </div>
            {% if read_time_minutes %}
            <div>
                <span style="display: block; color: var(--text); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Lectura</span>
                <span style="color: var(--cyan);">{{ read_time_minutes }} min</span>
            </div>
            {% endif %}
        </div>

        <!-- Article Description -->
        {% if description %}
        <p style="font-size: 1.125rem; color: var(--text); margin-bottom: 3rem; line-height: 1.8; font-style: italic;">{{ description }}</p>
        {% endif %}

        <!-- Article Body -->
        <div style="font-size: 1rem; color: var(--text); line-height: 1.8; margin-bottom: 4rem;">
            {{ content | safe }}
        </div>

        <!-- Article CTA -->
        <div style="padding: 2rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 0.25rem; margin-bottom: 4rem;">
            <h3 style="font-size: 1.25rem; font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--text-bright); margin-bottom: 1rem;">¿Necesita Asesoría Especializada?</h3>
            <p style="color: var(--text); margin-bottom: 1.5rem;">Disponible para consultoría técnica sobre infraestructura, ciberseguridad y cumplimiento normativo en Uruguay.</p>
            <div style="display: flex; gap: 1rem;">
                <a href="#contacto" class="btn-solid">Solicitar Consultoría</a>
                <a href="https://www.linkedin.com/in/antonio-galgano-votta-713b523a7/" target="_blank" rel="noopener noreferrer" class="btn-ghost">Conectar en LinkedIn</a>
            </div>
        </div>

        <!-- Share Links -->
        <div style="margin-bottom: 4rem;">
            <h4 style="font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text); margin-bottom: 1rem;">Compartir este artículo</h4>
            <div style="display: flex; gap: 1rem;">
                <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ schemaUrl | urlencode }}" target="_blank" rel="noopener noreferrer" style="color: var(--cyan); font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-decoration: none;">LinkedIn →</a>
                <a href="https://x.com/intent/tweet?url={{ schemaUrl | urlencode }}&text={{ title | urlencode }}&via=AntonioGalganoV" target="_blank" rel="noopener noreferrer" style="color: var(--cyan); font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-decoration: none;">X/Twitter →</a>
                <a href="mailto:?subject={{ title | urlencode }}&body=Lee%20este%20artículo:%20{{ schemaUrl | urlencode }}" style="color: var(--cyan); font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-decoration: none;">Email →</a>
            </div>
        </div>

        <!-- Related Articles -->
        {% if collections.articles %}
        <div style="margin-bottom: 4rem;">
            <h4 style="font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text); margin-bottom: 1.5rem;">Artículos Relacionados</h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem;">
                {% for article in collections.articles | limit(3) %}
                    {% if article.data.slug !== slug %}
                    <a href="/news/{{ article.data.slug }}/" style="padding: 1.5rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 0.25rem; text-decoration: none; transition: border-color 0.2s;">
                        <h5 style="font-family: 'IBM Plex Mono', monospace; color: var(--text-bright); margin-bottom: 0.5rem; font-size: 0.95rem; font-weight: 600;">{{ article.data.title }}</h5>
                        <time style="font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--text); display: block;" datetime="{{ article.data.published | isoDate }}">
                            {{ article.data.published | readableDate('es') }}
                        </time>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Back Link -->
        <nav style="text-align: center; padding-top: 2rem; border-top: 1px solid var(--border);">
            <a href="/news/" style="color: var(--cyan); font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; text-decoration: none;">← Volver a Noticias</a>
        </nav>
    </article>
</main>
