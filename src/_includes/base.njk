<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    {% if keywords %}
    <meta name="keywords" content="{{ keywords }}">
    {% endif %}
    <meta name="author" content="{{ site.author.name }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#07080f">
    <link rel="author" href="/humans.txt">
    <link rel="security" href="/.well-known/security.txt">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/images/favico/favicon_io/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favico/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favico/favicon_io/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favico/favicon_io/apple-touch-icon.png">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="{% if published %}article{% else %}website{% endif %}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:image" content="{{ site.url }}/images/favico/favicon_io/android-chrome-512x512.png">
    {% if published %}
    <meta property="article:published_time" content="{{ published | isoDate }}">
    <meta property="article:author" content="{{ author or site.author.name }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@AntonioGalganoV">
    <meta name="twitter:creator" content="@AntonioGalganoV">
    <link rel="stylesheet" href="/css/styles.css">
    {% if published %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "{{ title }}",
        "description": "{{ description }}",
        "image": "{{ site.url }}/images/favico/favicon_io/android-chrome-512x512.png",
        "author": {
            "@type": "Person",
            "name": "{{ author or site.author.name }}"
        },
        "datePublished": "{{ published | isoDate }}",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ site.url }}{{ page.url }}"
        }
    }
    </script>
    {% else %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.title }}",
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "inLanguage": "{{ site.language }}",
        "author": { "@type": "Person", "name": "{{ site.author.name }}" }
    }
    </script>
    {% endif %}
    {# JSON-LN Person [all pages]  #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Antonio Galgano Votta",
        "alternateName": "Antonio Galgano",
        "url": "https://antoniogalgano-uy.com/",
        "image": "https://antoniogalgano-uy.com/images/favico/favicon_io/apple-touch-icon.png",
        "jobTitle": "Consultor de Tecnologías de la Información",
        "areaServed": ["Uruguay", "América Latina"],
        "address": {
            "@type": "PostalAddress",
            "addressCountry": "UY",
            "addressLocality": "Montevideo"
        },
        "knowsAbout": ["Consultoría TI", "Ciberseguridad", "AGESIC", "Ley 18331", "Protección de Datos", "Infraestructura Digital", "Automatización"],
        "sameAs": [
            "https://www.linkedin.com/in/antonio-galgano-votta-713b523a7/",
            "https://x.com/AntonioGalganoV"
        ]
    }
    </script>
    {% block schema %}{% endblock %}
</head>
<body class="bg-slate-950 text-slate-100">

<!-- NAVIGATION -->
<nav class="border-b border-slate-800 sticky top-0 z-50 bg-slate-950/95 backdrop-blur">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
        <a href="/" class="nav-logo">AGV</a>
        <div class="hidden md:flex gap-8">
            <a href="/#sobre" class="text-sm font-medium hover:text-cyan-400 transition">Sobre mí</a>
            <a href="/#servicios" class="text-sm font-medium hover:text-cyan-400 transition">Servicios</a>
            <a href="/#marco" class="text-sm font-medium hover:text-cyan-400 transition">Marco UY</a>
            <a href="/news/" class="text-sm font-medium hover:text-cyan-400 transition {% if page.url == '/news/' %}text-cyan-400{% endif %}">Noticias</a>
            <a href="/#contacto" class="text-sm font-medium hover:text-cyan-400 transition">Contacto</a>
        </div>
    </div>
</nav>

<!-- CONTENT -->
{{ content | safe }}

<!-- FOOTER -->
<footer class="border-t border-slate-800 mt-20 py-12 bg-slate-900/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h3 class="text-sm font-semibold text-slate-400 mb-4">Sitios Relacionados</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                <a href="https://antoniogalgano.com" class="text-slate-300 hover:text-cyan-400 transition">antoniogalgano.com</a>
                <a href="https://antoniogalgano.es" class="text-slate-300 hover:text-cyan-400 transition">antoniogalgano.es</a>
                <a href="https://antoniogalgano.net" class="text-slate-300 hover:text-cyan-400 transition">antoniogalgano.net</a>
                <a href="https://antonio-galgano-votta.com" class="text-slate-300 hover:text-cyan-400 transition">antonio-galgano-votta.com</a>
                <a href="https://antoniogalganovotta.com" class="text-slate-300 hover:text-cyan-400 transition">antoniogalganovotta.com</a>
                <a href="https://antoniogalganovotta.es" class="text-slate-300 hover:text-cyan-400 transition">antoniogalganovotta.es</a>
            </div>
        </div>
        <div class="pt-8 border-t border-slate-700 text-center text-sm text-slate-400">
            <p>&copy; 2026 Antonio Galgano Votta. All rights reserved.</p>
            <p class="mt-2">
                <a href="/sitemap.xml" class="hover:text-cyan-400 transition">Sitemap</a> ·
                <a href="/robots.txt" class="hover:text-cyan-400 transition">Robots.txt</a> ·
                <a href="/news/" class="hover:text-cyan-400 transition">Noticias</a>
            </p>
        </div>
    </div>
</footer>

    <script>
        const observer = new IntersectionObserver(
            (entries) => entries.forEach(e => {
                if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
            }),
            { threshold: 0.08 }
        );
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
</body>
</html>
