{
  "name": "antoniogalgano-uy",
  "version": "1.0.0",
  "description": "Antonio Galgano Votta — Consultor TI & Ciberseguridad en Uruguay",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./_site/css/styles.css --minify",
    "build:11ty": "eleventy",
    "build": "npm run build:11ty && npm run build:css",
    "dev": "eleventy --serve",
    "watch": "concurrently \"eleventy --watch\" \"npm run watch:css\"",
    "watch:css": "tailwindcss -i ./src/input.css -o ./_site/css/styles.css --watch",
    "preview": "npm run build && npx eleventy --serve"
  },
  "keywords": [
    "Antonio Galgano Votta",
    "Consultor TI",
    "Ciberseguridad",
    "Uruguay"
  ],
  "author": "Antonio Galgano Votta",
  "license": "All Rights Reserved",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "concurrently": "^8.2.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.0.0"
  }
}
